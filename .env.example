# Base de datos
DB_HOST=localhost
DB_NAME=
DB_PASS=
DB_PORT=5432
DB_USER=
SQLALCHEMY_DATABASE_URI="postgresql+psycopg2://DB_USER:DB_PASS@DB_HOST:DB_PORT/DB_NAME"

# Google Cloud Storage depósitos
CLOUD_STORAGE_DEPOSITO_EDICTOS=
